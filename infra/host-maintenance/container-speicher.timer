[Unit]
Description=Container-Speicher alle 15 min messen (platform#3400)

[Timer]
# 15 min: die Messwoche bis 2026-09-30 soll anon-Spitzen und die Tagesrate der
# Limit-Treffer tragen. Ein Lauf dauert ~2 s (ein ssh-Aufruf, gemessen 2026-09-23).
OnCalendar=*:0/15
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
