{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/achimdehnert/platform/blob/main/infra/schemas/secrets-inventory.schema.json",
  "title": "Platform Secrets Inventory (ADR-045, KONZ-dev-hub-005 REC-1)",
  "description": "Schema fuer infra/secrets-inventory.yaml. Das Inventar ist SSoT fuer 'was liegt wo und womit beweist man es'. Es enthaelt NIE Werte. Die alte String-Form von consumers[] bleibt gueltig, wird aber als 'unvollstaendig' gezaehlt (tools/secrets_inventory_check.py).",
  "type": "object",
  "properties": {
    "server_side": { "type": "object" },
    "local": { "type": "object" },
    "sops": { "type": "object" }
  },
  "additionalProperties": { "$ref": "#/$defs/gruppe" },
  "$defs": {
    "gruppe": {
      "description": "Eine Sektion (shared, platform, risk-hub, wiederanlauf, ...) — Abbildung Secret-Name -> Eintrag.",
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9_.-]+$" },
      "additionalProperties": { "$ref": "#/$defs/eintrag" }
    },
    "eintrag": {
      "type": "object",
      "required": ["description"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "rotation": { "$ref": "#/$defs/rotation" },
        "consumers": {
          "type": "array",
          "items": { "$ref": "#/$defs/konsument" }
        },
        "escrow": {
          "description": "Wo eine Zweitkopie des Schluesselmaterials liegt, das den Lauf selbst traegt (MT-4). Zeiger, nie Wert.",
          "type": "string"
        },
        "last_audited": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "escrow_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "escrow_luecke": { "type": "string" },
        "zweitkopie_medium": { "type": "string" },
        "zweitkopie_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "location": { "type": "string" },
        "kette": { "type": "string" },
        "value_hint": {
          "description": "Nur fuer nicht-geheime Werte (Hostname, Benutzername). NIE fuer Schluesselmaterial.",
          "type": "string"
        },
        "deprecated": { "type": "boolean" },
        "replacement": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "rotation": {
      "enum": ["monthly", "quarterly", "yearly", "on_demand"]
    },
    "konsument": {
      "oneOf": [
        {
          "description": "ALT (deprecated): Freitext ohne Org und ohne Beleg. Bleibt gueltig, zaehlt als unvollstaendig.",
          "type": "string",
          "minLength": 1
        },
        { "$ref": "#/$defs/konsument_objekt" }
      ]
    },
    "konsument_objekt": {
      "type": "object",
      "required": ["kind", "ref", "name"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["github_repo_secret", "host_env_file", "service_api_key"] },
        "ref": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "note": { "type": "string" },
        "proof": { "$ref": "#/$defs/proof" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "github_repo_secret" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "ref": {
                "description": "vollqualifiziert org/repo",
                "pattern": "^[a-z0-9-]+/[a-z0-9._-]+$"
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "host_env_file" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "ref": {
                "description": "host:/absoluter/pfad",
                "pattern": "^[a-z0-9-]+:/.+$"
              }
            }
          }
        }
      ]
    },
    "proof": {
      "description": "Wie die Wirkung des neuen Werts belegt wird. Ohne proof ist ein Konsument nicht rotierbar — und wird gemeldet, nicht uebersprungen (AD-3).",
      "oneOf": [
        {
          "type": "object",
          "required": ["workflow", "log_marker"],
          "additionalProperties": false,
          "properties": {
            "workflow": { "type": "string", "minLength": 1 },
            "log_marker": { "type": "string", "minLength": 1 },
            "rueckfall_token": {
              "description": "true = der Workflow faellt auf GITHUB_TOKEN zurueck und ist damit KEIN sauberer Beleg (AD-4). Der Treiber vermerkt das im Log.",
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": ["command", "expect"],
          "additionalProperties": false,
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "expect": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
